<Project>
  <Target Name="ValidatePublication" BeforeTargets="PrepareForPublish">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../Directory.Build.props" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="_DeclaredPublicationVersion" />
    </XmlPeek>
    <Error Code="OLCPUB001" Condition="'$(Version)' != '$(_DeclaredPublicationVersion)'"
           Text="Версия приложения должна совпадать с Version в Directory.Build.props: $(_DeclaredPublicationVersion)." />
    <Error Code="OLCPUB002" Condition="'$(ReleaseTag)' != 'v$(Version)'"
           Text="Тег $(ReleaseTag) должен совпадать с v$(Version)." />
    <Error Code="OLCPUB003" Condition="'$(PackageVersion)' != '$(Version)'"
           Text="Версия пакета $(PackageVersion) должна совпадать с версией приложения $(Version)." />
    <Error Code="OLCPUB004" Condition="'$(ReleaseChannel)' != 'stable' and '$(ReleaseChannel)' != 'beta'"
           Text="Допустимые каналы публикации: stable, beta." />
    <Error Code="OLCPUB005"
           Condition="'$(SelfContained)' != 'false' or '$(UseAppHost)' != 'true' or '$(PublishTrimmed)' != 'false' or '$(PublishAot)' != 'false' or '$(PublishSingleFile)' != 'false' or '$(BundleAgent)' == 'false'"
           Text="Публикация требует framework-dependent Desktop и Agent с apphost, без trimming, AOT и single-file." />
    <Error Code="OLCPUB006"
           Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64' and '$(RuntimeIdentifier)' != 'osx-arm64' and '$(RuntimeIdentifier)' != 'osx-x64'"
           Text="Поддерживаются RID: win-x64, linux-x64, osx-arm64, osx-x64." />
  </Target>
</Project>
