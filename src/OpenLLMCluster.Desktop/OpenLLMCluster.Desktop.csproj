<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/open-llm-cluster.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <Import Project="../../build/Publication.props" />
  <ItemGroup>
    <ProjectReference Include="../OpenLLMCluster.Infrastructure/OpenLLMCluster.Infrastructure.csproj" />
    <ProjectReference Include="../OpenLLMCluster.Agent/OpenLLMCluster.Agent.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
    <EmbeddedResource Include="Localization/*.json" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Target Name="CopyDevelopmentAgent" AfterTargets="Build" Condition="'$(BundleAgent)' != 'false' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_DevelopmentAgentDirectory>$(MSBuildProjectDirectory)/../OpenLLMCluster.Agent/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/</_DevelopmentAgentDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_DevelopmentAgent Include="$(_DevelopmentAgentDirectory)**/*"
                         Exclude="$(_DevelopmentAgentDirectory)Agent/**/*;$(_DevelopmentAgentDirectory)publish/**/*;$(_DevelopmentAgentDirectory)win-*/**/*;$(_DevelopmentAgentDirectory)linux-*/**/*;$(_DevelopmentAgentDirectory)osx-*/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DevelopmentAgent)" DestinationFiles="@(_DevelopmentAgent->'$(OutDir)Agent/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBundledAgent" AfterTargets="Publish" Condition="'$(BundleAgent)' != 'false'">
    <PropertyGroup>
      <_AgentRuntimeArgument Condition="'$(RuntimeIdentifier)' != ''">--runtime &quot;$(RuntimeIdentifier)&quot;</_AgentRuntimeArgument>
      <_AgentPublishDirectory>$([System.IO.Path]::Combine('$(PublishDir)', 'Agent'))</_AgentPublishDirectory>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../OpenLLMCluster.Agent/OpenLLMCluster.Agent.csproj&quot; --configuration &quot;$(Configuration)&quot; $(_AgentRuntimeArgument) --self-contained false -p:Version=$(Version) -p:PackageVersion=$(PackageVersion) -p:UseAppHost=true -p:PublishTrimmed=false -p:PublishAot=false -p:PublishSingleFile=false --output &quot;$(_AgentPublishDirectory)&quot;" />
  </Target>
  <Import Project="../../build/Publication.targets" />
</Project>
